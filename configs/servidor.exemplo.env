# Servidor de treino — MODELO. Copiar para `servidor.local.env` e preencher.
#
#     cp configs/servidor.exemplo.env configs/servidor.local.env
#
# O ficheiro real não é versionado: o endereço, o utilizador e a impressão
# digital da chave descrevem infraestrutura de terceiros (aqui, do ISCTE) e não
# este trabalho — num repositório público seriam um alvo confirmado e um
# utilizador válido à espera de quem tente a password.
#
# A password NUNCA entra aqui nem em ficheiro nenhum: é pedida na altura, pela
# vista «Servidor» do dashboard, e vive só na memória da sessão.
SWARM_USER=<utilizador>
SWARM_HOST=<endereço ou nome da máquina>
SWARM_HOST_ROTULO=<nome curto para o seletor>
SWARM_HOSTKEY=SHA256:<impressão digital ed25519 da máquina>
SWARM_REMOTE_DIR=/home/<utilizador>/swarm-robotics-tese
