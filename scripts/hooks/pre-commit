#!/usr/bin/env bash
# pre-commit — a regra 6(b) do PLANO_MESTRE, aplicada sozinha.
#
# *"Antes de dar qualquer sessão por concluída: os números citados batem com o
# CSV fonte?"* — verificado à mão a 18, 25 e 27 de julho de 2026. Este hook corre
# o `verificar_numeros_tese.py` quando o commit mexe na tese ou nos dados que a
# sustentam, e recusa o commit se algum dos 98 valores deixar de bater.
#
# SÓ CORRE quando é relevante: um commit que toca em scripts, docs ou no artigo
# passa sem esperar. Um hook que corre sempre é um hook que se desliga.
#
# ESCAPE: `git commit --no-verify`. É legítimo em pelo menos dois casos —
# escrever números de uma campanha cujo CSV ainda não chegou, ou commitar um
# trabalho a meio. O que o hook impede é o caso que interessa: **entregar** com a
# tabela dessincronizada dos dados e não dar por isso.
#
# Instalação (não é automática — .git/hooks não é versionado):
#     scripts/instalar_hooks.sh
set -uo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
ALVOS='^(Tese/main\.tex|results/graficos_tese/final_7d/|results/estatisticas/escalabilidade_)'
# A secção do mapa grande tem verificador próprio (o `main.tex` não a inclui
# enquanto não houver dados do F2, por isso nunca entraria pelos ALVOS acima).
# 18 ago: o ARTIGO tambem entra aqui. Ganhou nesse dia a seccao do mapa composto,
# e o verificar_mapa_grande.py passou a conferi-la contra os MESMOS CSV da tese —
# o artigo e um documento a parte e ja divergiu da dissertacao duas vezes.
ALVOS_MAPA='^(Tese/seccao_mapa_grande\.tex|results/mapa_grande/|Artigo/artigo\.tex)'

# 20 ago: o DASHBOARD. Nao e entregavel, mas e o que se projeta na defesa, e a
# revisao das 16 vistas encontrou defeitos que nenhum verificador via. Tem de
# entrar JA AQUI: com o corte de saida so a olhar para a tese e para o mapa, um
# commit que so mexesse no dashboard saia antes de chegar as suas verificacoes —
# que foi o que aconteceu ao commit que as instalou.
ALVOS_DASH='^(dashboard/|configs/vitrine\.yaml)'

# 20 ago: o INDICE DOS SCRIPTS. A regua existia e nunca travou nada — imprimia
# os scripts em falta e saia com 0 —, e foi assim que dois verificadores novos
# ficaram de fora do indice sem ninguem dar por isso.
ALVOS_SCRIPTS='^scripts/'

MEXEU_TESE=0
MEXEU_MAPA=0
MEXEU_DASH=0
MEXEU_SCRIPTS=0
git diff --cached --name-only | grep -qE "$ALVOS"      && MEXEU_TESE=1
git diff --cached --name-only | grep -qE "$ALVOS_MAPA" && MEXEU_MAPA=1
git diff --cached --name-only | grep -qE "$ALVOS_DASH" && MEXEU_DASH=1
git diff --cached --name-only | grep -qE "$ALVOS_SCRIPTS" && MEXEU_SCRIPTS=1

if [ "$MEXEU_TESE" -eq 0 ] && [ "$MEXEU_MAPA" -eq 0 ] &&
   [ "$MEXEU_DASH" -eq 0 ] && [ "$MEXEU_SCRIPTS" -eq 0 ]; then
    exit 0
fi

PY="$RAIZ/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$RAIZ/.venv/bin/python"
[ -x "$PY" ] || PY=python

echo "[pre-commit] a tese, os dados ou o dashboard mudaram — a verificar..."
# Três verificadores. As TABELAS (352 valores) e as CONTAGENS EM PROSA — o
# segundo entrou a 5 ago, depois de três erros seguidos aparecerem todos em
# afirmações sobre os números, e não nos números, que já tinham rede. E, desde
# 6 ago, a SECÇÃO DO MAPA GRANDE (20 valores), que tem fontes próprias: a
# geometria vem do simulador e o F1 dos CSV do zero-shot.
OK=1
if [ "$MEXEU_TESE" -eq 1 ]; then
    "$PY" "$RAIZ/scripts/verificar_numeros_tese.py" || OK=0
    "$PY" "$RAIZ/scripts/verificar_contagens_prosa.py" || OK=0
    # 13 ago: a limitacao do spawn no Gargalo (10 valores). Mede no simulador e
    # le os esperados do proprio main.tex — uma alteracao a geometria do cenario
    # ou um numero mudado a mao param aqui.
    "$PY" "$RAIZ/scripts/verificar_spawn_gargalo.py" || OK=0
    # 17 ago: o VOCABULARIO DO PROTOCOLO (155 valores) — «7 execucoes», «195
    # minutos», «20 episodios», «n=28» — contra as campanhas que correram. Le a
    # seccao do mapa grande tambem, por isso corre nos dois ramos.
    "$PY" "$RAIZ/scripts/verificar_protocolo.py" || OK=0
    # 18 ago: a LIMITACAO DA DIMENSAO VERTICAL (8 valores). Entrou porque
    # falhava ha dias sem ninguem dar por isso: os episodios do mapa grande
    # foram exportados para `results/episodios_3d/` e o verificador passou a
    # ler 24 ficheiros onde a tese fala de 21 celulas (tres controladores x
    # SETE cenarios). E barato (<1 s) e le a geometria do simulador.
    "$PY" "$RAIZ/scripts/verificar_vertical.py" || OK=0
    # 18 ago: as REMISSOES (245). O LaTeX nao acusa uma remissao com o TIPO trocado - a
    # referencia resolve e manda o leitor ao sitio errado -, nem uma tabela que
    # nenhuma frase chama. Custa milissegundos: le dois .tex.
    "$PY" "$RAIZ/scripts/verificar_remissoes.py" || OK=0
    # 18 ago: PT-PT. A dissertacao e o artigo sao em portugues de Portugal por
    # decisao declarada (22 jun) e parte do texto passou por ferramentas que
    # produzem PT-BR por omissao. Procura lexico inequivoco e a opcao do babel.
    "$PY" "$RAIZ/scripts/verificar_ptpt.py" || OK=0
    # 20 ago: ESTRUTURA (acronimos e flutuantes). Nao olha para numeros: garante
    # que a Lista de Acronimos descreve o que a tese usa - o `QI`, usado 30
    # vezes, nao estava la - e que nenhuma figura ou tabela fica orfa, com as
    # citacoes por intervalo resolvidas. Le o .tex e o .aux, custa milissegundos.
    "$PY" "$RAIZ/scripts/verificar_estrutura_tese.py" || OK=0
fi
if [ "$MEXEU_MAPA" -eq 1 ]; then
    "$PY" "$RAIZ/scripts/verificar_mapa_grande.py" || OK=0
fi
# As figuras do artigo sao copias das da tese e ja ficaram para tras duas vezes
# (oito numa revisao, tres noutra). Compara-as: as copias tem de ser identicas e
# as versoes proprias da coluna nao podem ser mais velhas do que a fonte.
if git diff --cached --name-only | grep -qE '^(Artigo/|Tese/images/)'; then
    "$PY" "$RAIZ/scripts/verificar_figuras_artigo.py" || OK=0
fi
# 20 ago: o DASHBOARD. Nao e entregavel, mas e o que se projeta na defesa - e a
# revisao das 16 vistas encontrou defeitos que nenhum verificador via, porque
# todos olhavam para numeros e nenhum para o que o ecra DIZ. Corre quando se
# mexe no dashboard ou na selecao da vitrine (o plano esta em
# docs/PLANO_REVISAO_DASHBOARD.md):
#   · verificar_dashboard    os 51 valores + o vocabulario (cinco variantes dos
#                            nomes dos cenarios chegaram a conviver no ecra);
#   · verificar_vitrine      as legendas escritas a mao contra os CSV;
#   · verificar_comandos_    os comandos que a Proveniencia manda copiar.
if [ "$MEXEU_DASH" -eq 1 ]; then
    "$PY" "$RAIZ/scripts/verificar_dashboard.py" || OK=0
    "$PY" "$RAIZ/scripts/verificar_vitrine.py" || OK=0
    "$PY" "$RAIZ/scripts/verificar_comandos_dashboard.py" || OK=0
    "$PY" "$RAIZ/scripts/verificar_ptpt.py" || OK=0
fi
# O indice de scripts/README.md nomeia todos os scripts, e so os que existem.
if [ "$MEXEU_SCRIPTS" -eq 1 ]; then
    "$PY" "$RAIZ/scripts/testes/conferir_readme_scripts.py" || OK=0
fi
[ "$OK" -eq 1 ] && exit 0

cat >&2 <<'FIM'

[pre-commit] COMMIT RECUSADO: alguma coisa não bate com as fontes.

  · Se os CSV é que são os novos, regenera as tabelas antes de commitar.
  · Se estás a escrever números de uma campanha que ainda não chegou, ou a
    guardar trabalho a meio, passa com:  git commit --no-verify

FIM
exit 1
